{
  "name": "cilamai",
  "productName": "CilamAI",
  "description": "CilamAI Desktop App",
  "version": "0.1.0.1",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "cilamai": "bin/cilamai.js"
  },
  "author": "CilamAI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CilamAI/CilamAI.git"
  },
  "files": [
    "bin",
    "out",
    "resources",
    "LICENSE"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:nsis": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.cilamai.desktop",
    "productName": "CilamAI",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CilamAI"
    },
    "linux": {
      "target": [
        "tar.gz"
      ]
    },
    "directories": {
      "output": "release_build"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.3.0": true
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "pngjs": "^7.0.0"
  }
}